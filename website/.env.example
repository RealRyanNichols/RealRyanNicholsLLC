NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SITE_URL=https://realryannichols.com

# Resend (optional — for emailing new posts to subscribers)
# Sign up at https://resend.com, verify a sending domain (e.g. realryannichols.com),
# then paste the API key + the verified "From" address here.
# The /api/notify-subscribers endpoint returns 503 until both are set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=updates@realryannichols.com

# Comma-separated list of emails granted admin powers (e.g. blast email button).
# Whoever signs into the site with one of these emails sees author-only tools.
ADMIN_EMAILS=
