NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SITE_URL=https://realryannichols.com

# Resend (optional — for emailing new posts to subscribers)
# Sign up at https://resend.com, verify a sending domain (e.g. realryannichols.com),
# then paste the API key + the verified "From" address here.
# The /api/notify-subscribers endpoint returns 503 until both are set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=updates@realryannichols.com

# Comma-separated list of emails granted admin powers (e.g. blast email button).
# Whoever signs into the site with one of these emails sees author-only tools.
# Note: also seed the public.admin_emails table in Supabase so RLS picks them up.
ADMIN_EMAILS=

# Physical mailing address — required for CAN-SPAM compliance. A PO box is fine.
# Appears in the footer of every subscriber email and on the privacy page.
# /api/subscribe and /api/notify-subscribers return 503 until this is set.
SITE_MAILING_ADDRESS="PO Box 0000, City, ST 00000, USA"

# Mux — for HD video uploads, live streaming, simulcast targets, transcoding
# to adaptive bitrate HLS, and playback.
# Sign up at https://dashboard.mux.com, create an API token under
# Settings → Access Tokens with full Video permissions, paste both values here.
# The "+ New" → Video tab and /admin/live controls need these values.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Mux webhook secret — generated when you create a webhook in Mux dashboard
# pointing at https://realryannichols.com/api/mux-webhook . Required for the
# server to verify webhook signatures, flip video posts to "published", and
# update live stream status when a broadcast starts or ends.
MUX_WEBHOOK_SECRET=

# Supabase service-role key — used ONLY by /api/mux-webhook to update post rows
# after Mux finishes transcoding (no user session is present in webhooks).
# Find it at: Supabase Dashboard → Project Settings → API → service_role key.
# NEVER expose this to the browser. It bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — required to enable the AI Case Briefings page at
# /case/briefing. The route returns 503 until this is set, so the rest
# of the site ships without LLM coupling. Throttled to 1 request per IP
# per 10s, cached 15 min, so the bill stays small.
# Get one at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=

# Analytics / advertising pixels (optional). Each lights up only when set,
# so the site ships clean. NEXT_PUBLIC_ vars are exposed to the browser.
# Meta (Facebook) Pixel — retargeting + conversion tracking for FB/IG
# traffic. Find the ID in Meta Events Manager (a ~15-digit number).
NEXT_PUBLIC_META_PIXEL_ID=
# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=

# Stripe — the store + native checkout (book, services, and orders). The money
# layer ships DORMANT: every checkout route returns 503 until STRIPE_SECRET_KEY
# is set. Use a RESTRICTED key with WRITE on Checkout Sessions, Payment Intents,
# Products, Prices, Customers, Subscriptions (+ READ Charges/Balance for the
# /admin/donations readout). TEST mode first, then live.
STRIPE_SECRET_KEY=
# Webhook signing secret — Stripe -> Developers -> Webhooks, endpoint
# https://www.realryannichols.com/api/stripe/webhook . Verifies events.
STRIPE_WEBHOOK_SECRET=
# Where J6 free-claim notifications are emailed (defaults to RESEND_FROM_EMAIL).
ADMIN_NOTIFY_EMAIL=

# Deadman switch — disabled until all three are set. Use long private phrases.
# Hash format: sha256(`${DEADMAN_SECRET_SALT}:${your_private_code}`) as hex.
# Generate hashes with:
# DEADMAN_SECRET_SALT='long-random-salt' node scripts/hash-deadman-code.mjs 'your private code'
# The switch only publishes draft posts marked category "deadman-release".
# It never releases private tips, messages, contact info, uploads, or
# unreviewed submissions.
DEADMAN_SECRET_SALT=
DEADMAN_ACTIVATION_HASH=
DEADMAN_REVERSAL_HASH=
# Vercel Cron sends Authorization: Bearer $CRON_SECRET automatically when set.
DEADMAN_CRON_SECRET=
CRON_SECRET=
